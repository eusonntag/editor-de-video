{
  "id": "escuro",
  "nome": "Escuro elegante",
  "descricao": "Vidro escuro translúcido, texto claro e destaque amarelo. Sóbrio, combina com quase tudo.",
  "fontes": {"titulo": ["Inter", "Inter-900.ttf", 900], "texto": ["Inter", "Inter-700.ttf", 700], "apoio": ["Inter", "Inter-400.ttf", 400]},
  "vars": {
