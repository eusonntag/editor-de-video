    "--destaque": "#ffd400", "--destaque-2": "#4ade80", "--destaque-3": "#fb923c", "--sobre-destaque": "#111111",
    "--borda": "2px solid rgba(255,255,255,.10)", "--raio": "26px", "--sombra": "0 30px 80px -20px rgba(0,0,0,.6)",
    "--caixinha": "rgba(255,255,255,.08)", "--kicker-espaco": ".16em", "--desfoque": "blur(10px)"
